-- spawn_stitch_decoder (Mortal Sin)
------------------------------------------------------
{r%level:k02_trucks_cemetery}
xr_effects.spawn_stitch_decoder = function(actor, npc, p)
    local quest_item_locations_list = {
        {{w%x:50.247924804688}, {w%y:3.9755771160126}, {w%z:156.77543640137}, {w%lvid:509188}, {w%gvid:5248}},
        {{w%x:51.563461303711}, {w%y:7.1993789672852}, {w%z:224.42543029785}, {w%lvid:514950}, {w%gvid:5155}},
        {{w%x:19.012723922729}, {w%y:1.1766533851624}, {w%z:112.65353393555}, {w%lvid:472104}, {w%gvid:5144}},
    }
    local i = math.random(#quest_item_locations_list)
    local loc = quest_item_locations_list[i]
    local pos = vector():set(loc[1], loc[2], loc[3])
    local se_obj = alife_create("stitch_decoder", pos, loc[4], loc[5])
    if se_obj then
        item_radio.add_target(se_obj.id, 171, 75)
    else
        printe("!ERROR: unable to spawn stitch_decoder")
    end
end

