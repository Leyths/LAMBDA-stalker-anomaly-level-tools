------------------------------------------------------
-- pos_itms table and spawn_item_at_pos override
-- Items grouped by level for tag rewriter context
------------------------------------------------------
{r%level:labx8}
local pos_itms_override = {
    ["drx_x8_documents"] = {{w%x:-101.9361038208}, {w%y:-31.361772537231}, {w%z:90.615669250488}, {w%lvid:636}, {w%gvid:5090}},
    ["lx8_history_documents"] = {{w%x:-93.635635375977}, {w%y:-27.296674728394}, {w%z:96.18310546875}, {w%lvid:1318}, {w%gvid:5079}},
    ["lx8_history_2_documents"] = {{w%x:-116.10192871094}, {w%y:-27.196212768555}, {w%z:82.614562988281}, {w%lvid:30}, {w%gvid:5090}},
    ["lx8_history_3_documents"] = {{w%x:-43.184757232666}, {w%y:-19.527189254761}, {w%z:67.334884643555}, {w%lvid:6770}, {w%gvid:5094}},
{r%level:l08u_brainlab}
    ["drx_x16_documents"] = {{w%x:-46.306594848633}, {w%y:20.461000442505}, {w%z:2.1229863166809}, {w%lvid:2220}, {w%gvid:3792}},
{r%level:l04u_labx18}
    ["drx_x18_documents"] = {{w%x:23.617618560791}, {w%y:-5.6467723846436}, {w%z:-18.183609008789}, {w%lvid:6311}, {w%gvid:3760}},
{r%level:l10u_bunker}
    ["drx_x19_documents"] = {{w%x:6.817852973938}, {w%y:-7.8305835723877}, {w%z:-15.558134078979}, {w%lvid:7638}, {w%gvid:3842}},
{r%level:l03u_agr_underground}
    ["drx_agr_u_documents"] = {{w%x:46.072761535645}, {w%y:1.8872995376587}, {w%z:75.970985412598}, {w%lvid:3968}, {w%gvid:3630}},
{r%level:jupiter_underground}
    ["drx_jup_u_documents"] = {{w%x:27.983295440674}, {w%y:12.515381813049}, {w%z:-1.1357840299606}, {w%lvid:39736}, {w%gvid:4861}},
{r%level:zaton}
    ["wpn_gauss_quest"] = {{w%x:-426.44213867188}, {w%y:26.069364547729}, {w%z:-383.1135559082}, {w%lvid:138111}, {w%gvid:4140}},
}

xr_effects.spawn_item_at_pos = function(actor, npc, p)
    if not (p and p[1]) then return end

    if (pos_itms_override[p[1]]) then
        local v = pos_itms_override[p[1]]
        local pos = vector():set(v[1], v[2], v[3])
        local se_obj = alife_create(p[1], pos, v[4], v[5])
        if (not se_obj) then
            printe("!ERROR: spawn_item_at_pos | unable to spawn [%s]", p[1])
        end
    else
        -- Item not in our override table, spawn at actor position as fallback
        local se_obj = alife_create_item(p[1], db.actor)
        if se_obj then
            news_manager.relocate_item(db.actor, "in", p[1])
        end
    end
end
