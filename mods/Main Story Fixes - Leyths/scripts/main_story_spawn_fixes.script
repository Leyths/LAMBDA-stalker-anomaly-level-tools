--[[
    Main Story Fixes - Leyths
    Override hardcoded LVID/GVID values in xr_effects spawn functions
    so they can be recomputed during level recompilation via tag rewriter.
--]]

------------------------------------------------------
-- spawn_strelok_notes (Living Legend Task 2)
------------------------------------------------------
{r%level:l03u_agr_underground}
xr_effects.spawn_strelok_notes = function(actor, npc, p)
    local pos = vector():set({w%x:43.601459503174}, {w%y:1.3544018268585}, {w%z:75.227851867676})
    local se_obj = alife_create("strelok_notes", pos, {w%lvid:3762}, {w%gvid:3630})
    if (not se_obj) then
        printe("!ERROR: unable to spawn strelok_notes")
    end
end

