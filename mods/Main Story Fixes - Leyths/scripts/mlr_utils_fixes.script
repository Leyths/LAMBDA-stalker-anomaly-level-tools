mlr_utils.spawn_item = function(name)
    local tbl = SPWN_override[name]
    if not tbl then return end
    for k, v in pairs(tbl) do
        for i = 1, (v[6] or 1) do
            alife_create(k, vector():set(v[1], v[2], v[3]), v[4], v[5])
        end
    end
end

