mlr_utils.change_lvl = function(p)
    if db.actor:is_talking() then
        db.actor:stop_talk()
    end
    local v = CLT_override[p]
    if v then
        ChangeLevel(vector():set(v[1], v[2], v[3]), v[4], v[5], vector():set(v[6] or 0, v[7] or 0, v[8] or 0), true)
    end
end
