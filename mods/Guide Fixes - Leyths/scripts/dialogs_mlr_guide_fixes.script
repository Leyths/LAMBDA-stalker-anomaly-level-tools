------------------------------------------------------
-- teleport_for_totaliz (Arena teleport for Totalizator)
------------------------------------------------------
{r%level:l05_bar}
dialogs_mlr.teleport_for_totaliz = function(first_speaker, second_speaker)
    local box = get_story_object("bar_arena_inventory_box")
    if (box) then
        local function transfer_object_item(item)
            db.actor:transfer_item(item, box)
        end
        db.actor:inventory_for_each(transfer_object_item)
        level.add_pp_effector("fade_in.ppe", 200, false)
        db.actor:set_actor_position(vector():set({w%x:139.61517333984}, {w%y:-13.390427589417}, {w%z:100.86038208008}), {w%lvid:37564}, {w%gvid:1710})
    end
    local spawn_items = {}
    if has_alife_info("totaliz_money_has_gone") then
        table.insert(spawn_items, "wpn_binoc")
    end
    local k,v = 0,0
    for k,v in pairs(spawn_items) do
        alife_create_item(v, db.actor)
    end
end
