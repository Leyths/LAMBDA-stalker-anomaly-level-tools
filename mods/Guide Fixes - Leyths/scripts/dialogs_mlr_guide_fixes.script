--[[
    Guide Fixes - Leyths
    Override hardcoded LVID/GVID values in dialogs_mlr guide functions
    so they can be recomputed during level recompilation via tag rewriter.
--]]

------------------------------------------------------
-- marsh_post_guid (Guide teleport to Marsh Post)
------------------------------------------------------
{r%level:k00_marsh}
dialogs_mlr.marsh_post_guid = function(first_speaker, second_speaker)
    level.add_pp_effector("fade_in.ppe", 200, false)
    db.actor:set_actor_position(vector():set({w%x:-294.81405639648}, {w%y:0.71730107069016}, {w%z:21.673492431641}), {w%lvid:3145}, {w%gvid:153})
end

